@page
@model VillaAgency.Web.Pages.IndexModel
@{
    ViewData["Title"] = "صفحه اصلی";
}

<div class="main-banner">
    <div class="owl-carousel owl-banner">
        @if (Model.Vm.SliderProperties.Any())
        {
            @foreach (var property in Model.Vm.SliderProperties)
            {
                <div class="item" style="background-image: url(@Url.Content(property.ImageUrls.FirstOrDefault() ?? "~/images/default-property.jpg")); background-size: cover; background-position: center;">
                    <div class="header-text">
                        <span class="category">@property.CategoryName، <em>@property.Address.Split('،').FirstOrDefault()</em></span>
                        <h2><a asp-page="/PropertyDetails" asp-route-id="@property.Id">@property.Title</a></h2>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="item item-1">
                <div class="header-text">
                    <span class="category">تهران، <em>ایران</em></span>
                    <h2>به آژانس املاک ما<br>خوش آمدید</h2>
                </div>
            </div>
        }
    </div>
</div>

@if (Model.Vm.FeaturedProperty != null)
{
    <div class="featured section">
        <div class="container">
            <div class="row">
                <div class="col-lg-4">
                    <div class="left-image">
                        <img src="@Url.Content(Model.Vm.FeaturedProperty.ImageUrls.FirstOrDefault() ?? "~/images/featured.jpg")" alt="ملک ویژه">
                        <a asp-page="/PropertyDetails" asp-route-id="@Model.Vm.FeaturedProperty.Id"><img src="~/images/featured-icon.png" alt="" style="max-width: 60px; padding: 0px;"></a>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="section-heading">
                        <h6>| ملک ویژه</h6>
                        <h2>@Model.Vm.FeaturedProperty.Title</h2>
                    </div>
                    <div class="accordion" id="accordionExample">
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingOne">
                                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                                    توضیحات ملک
                                </button>
                            </h2>
                            <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#accordionExample">
                                <div class="accordion-body">
                                    @Model.Vm.FeaturedProperty.Description
                                </div>
                            </div>
                        </div>
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingTwo">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                                    چرا این ملک بهترین است؟
                                </button>
                            </h2>
                            <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#accordionExample">
                                <div class="accordion-body">
                                    این ملک با داشتن امکانات مدرن و موقعیت جغرافیایی عالی، یکی از بهترین گزینه‌ها برای سرمایه‌گذاری و سکونت می‌باشد.
                                </div>
                            </div>
                        </div>
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingThree">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                                    جزئیات پرداخت چگونه است؟
                                </button>
                            </h2>
                            <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#accordionExample">
                                <div class="accordion-body">
                                   برای اطلاع از شرایط پرداخت و دریافت مشاوره مالی، می‌توانید با کارشناسان ما در تماس باشید.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="info-table">
                        <ul>
                            <li>
                                <img src="~/images/info-icon-01.png" alt="" style="max-width: 52px;">
                                <h4>@Model.Vm.FeaturedProperty.Area متر مربع<br><span>فضای کل</span></h4>
                            </li>
                            <li>
                                <img src="~/images/info-icon-02.png" alt="" style="max-width: 52px;">
                                <h4>قرارداد<br><span>آماده انتقال</span></h4>
                            </li>
                            <li>
                                <img src="~/images/info-icon-03.png" alt="" style="max-width: 52px;">
                                <h4>پرداخت<br><span>نقدی / اقساطی</span></h4>
                            </li>
                            <li>
                                <img src="~/images/info-icon-04.png" alt="" style="max-width: 52px;">
                                <h4>امنیت<br><span>نگهبانی ۲۴/۷</span></h4>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
<div class="video section">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 offset-lg-4">
                <div class="section-heading text-center">
                    <h6>| نمایش ویدیو</h6>
                    <h2>نمایی نزدیک‌تر و حسی متفاوت</h2>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="video-content">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 offset-lg-2">
                <div class="video-frame">
                    <img src="~/images/video-frame.jpg" alt="ویدئوی معرفی ملک">
                    <a href="https://youtube.com" target="_blank"><i class="fa fa-play"></i></a>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="fun-facts">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="wrapper">
                    <div class="row">
                        <div class="col-lg-4">
                            <div class="counter">
                                <h2 class="timer count-title count-number" data-to="@Model.Vm.TotalPropertiesCount" data-speed="1000"></h2>
                                <p class="count-text ">ملک<br>ثبت شده</p>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="counter">
                                <h2 class="timer count-title count-number" data-to="@Model.Vm.TotalAgentsCount" data-speed="1000"></h2>
                                <p class="count-text ">مشاور<br>فعال</p>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="counter">
                                <h2 class="timer count-title count-number" data-to="24" data-speed="1000"></h2>
                                <p class="count-text ">جایزه<br>دریافت شده</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="section best-deal">
    <div class="container">
        <div class="row">
            <div class="col-lg-4"><div class="section-heading"><h6>| بهترین معامله</h6><h2>بهترین معامله خود را همین حالا پیدا کنید!</h2></div></div>
            <div class="col-lg-12">
                <div class="tabs-content">
                    <div class="row">
                        <div class="nav-wrapper">
                            <ul class="nav nav-tabs" role="tablist">
                                <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#appartment">آپارتمان</button></li>
                                <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#villa">خانه ویلایی</button></li>
                                <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#penthouse">پنت‌هاوس</button></li>
                            </ul>
                        </div>
                        <div class="tab-content">
                            <div class="tab-pane fade show active" id="appartment" role="tabpanel">
                                @if (Model.Vm.ApartmentDeals != null)
                                {
                                    var property = Model.Vm.ApartmentDeals;
                                    <div class="row">
                                        <div class="col-lg-3"><div class="info-table"><ul><li>فضای کل <span>@property.Area متر مربع</span></li><li>شماره طبقه <span>@property.Floor</span></li><li>تعداد اتاق <span>@property.Bedrooms</span></li></ul></div></div>
                                        <div class="col-lg-6"><img src="@Url.Content(property.ImageUrls.FirstOrDefault() ?? "~/images/deal-01.jpg")" alt="@property.Title"></div>
                                        <div class="col-lg-3"><h4>@property.Title</h4><p>@property.Description</p><div class="main-button"><a asp-page="/PropertyDetails" asp-route-id="@property.Id">رزرو بازدید</a></div></div>
                                    </div>
                                }
                                else
                                {
                                    <p class="text-center p-5">در حال حاضر معامله ویژه‌ای برای آپارتمان وجود ندارد.</p>
                                }
                            </div>
                            <div class="tab-pane fade" id="villa" role="tabpanel">
                                @if (Model.Vm.VillaDeals != null)
                                {
                                    var property = Model.Vm.VillaDeals;
                                    <div class="row">
                                        <div class="col-lg-3"><div class="info-table"><ul><li>فضای کل <span>@property.Area متر مربع</span></li><li>شماره طبقه <span>@property.Floor</span></li><li>تعداد اتاق <span>@property.Bedrooms</span></li></ul></div></div>
                                        <div class="col-lg-6"><img src="@Url.Content(property.ImageUrls.FirstOrDefault() ?? "~/images/deal-02.jpg")" alt="@property.Title"></div>
                                        <div class="col-lg-3"><h4>@property.Title</h4><p>@property.Description</p><div class="main-button"><a asp-page="/PropertyDetails" asp-route-id="@property.Id">رزرو بازدید</a></div></div>
                                    </div>
                                }
                                else
                                {
                                    <p class="text-center p-5">در حال حاضر معامله ویژه‌ای برای ویلا وجود ندارد.</p>
                                }
                            </div>
                            <div class="tab-pane fade" id="penthouse" role="tabpanel">
                                @if (Model.Vm.PenthouseDeals != null)
                                {
                                    var property = Model.Vm.PenthouseDeals;
                                    <div class="row">
                                        <div class="col-lg-3"><div class="info-table"><ul><li>فضای کل <span>@property.Area متر مربع</span></li><li>شماره طبقه <span>@property.Floor</span></li><li>تعداد اتاق <span>@property.Bedrooms</span></li></ul></div></div>
                                        <div class="col-lg-6"><img src="@Url.Content(property.ImageUrls.FirstOrDefault() ?? "~/images/deal-03.jpg")" alt="@property.Title"></div>
                                        <div class="col-lg-3"><h4>@property.Title</h4><p>@property.Description</p><div class="main-button"><a asp-page="/PropertyDetails" asp-route-id="@property.Id">رزرو بازدید</a></div></div>
                                    </div>
                                }
                                else
                                {
                                    <p class="text-center p-5">در حال حاضر معامله ویژه‌ای برای پنت‌هاوس وجود ندارد.</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="properties section">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 offset-lg-4"><div class="section-heading text-center"><h6>| املاک</h6><h2>جدیدترین املاک ثبت شده</h2></div></div>
        </div>
        <div class="row">
            @foreach (var property in Model.Vm.LatestProperties)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="item">
                        <a asp-page="/PropertyDetails" asp-route-id="@property.Id"><img src="@Url.Content(property.ImageUrls.FirstOrDefault() ?? "~/images/default-property.jpg")" onerror="this.onerror=null; this.src='@Url.Content("~/images/default-property.jpg")';" height="200px" alt="@property.Title"></a>
                        <span class="category">@property.CategoryName</span>
                        <h6>@property.Price.ToString("N0") تومان</h6>
                        <h4><a asp-page="/PropertyDetails" asp-route-id="@property.Id">@property.Title</a></h4>
                        <ul>
                            <li>اتاق خواب: <span>@property.Bedrooms</span></li>
                            <li>مساحت: <span>@property.Area متر مربع</span></li>
                        </ul>
                        <div class="main-button">
                            <a asp-page="/PropertyDetails" asp-route-id="@property.Id">مشاهده جزئیات</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div class="contact section">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 offset-lg-4">
                <div class="section-heading text-center">
                    <h6>| تماس با ما</h6>
                    <h2>با مشاوران ما در تماس باشید</h2>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="contact-content">
    <div class="container">
        <div class="row">
            <div class="col-lg-7">
                <div id="map">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d12469.776493332698!2d-80.14036379941481!3d25.907788681148624!2m3!1f357.26927939317244!2f20.870722720054623!3f0!3m2!1i1024!2i768!4f35!3m3!1m2!1s0x88d9add4b4ac788f%3A0xe77469d09480fcdb!2sSunny%20Isles%20Beach!5e1!3m2!1sen!2sth!4v1642869952544!5m2!1sen!2sth" width="100%" height="500px" frameborder="0" style="border:0; border-radius: 10px; box-shadow: 0px 0px 15px rgba(0, 0, 0, 0.15);" allowfullscreen=""></iframe>
                </div>
                <div class="row">
                    <div class="col-lg-6">
                        <div class="item phone">
                            <img src="~/images/phone-icon.png" alt="" style="max-width: 52px;">
                            <h6>۰۱۲-۳۴۵-۶۷۸۹<br><span>شماره تماس</span></h6>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="item email">
                            <img src="~/images/email-icon.png" alt="" style="max-width: 52px;">
                            <h6>info@villa.co<br><span>ایمیل کاری</span></h6>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <form id="contact-form" method="post">

                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    @if (!string.IsNullOrEmpty(Model.StatusMessage))
                    {
                        <div class="alert alert-success">
                            @Model.StatusMessage
                        </div>
                    }

                    <div class="row">
                        <div class="col-lg-12">
                            <fieldset>
                                <label asp-for="Input.Name">نام کامل</label>
                                <input asp-for="Input.Name" placeholder="نام شما..." autocomplete="on">
                                <span asp-validation-for="Input.Name" class="text-danger"></span>
                            </fieldset>
                        </div>
                        <div class="col-lg-12">
                            <fieldset>
                                <label asp-for="Input.Email">آدرس ایمیل</label>
                                <input asp-for="Input.Email" placeholder="ایمیل شما...">
                                <span asp-validation-for="Input.Email" class="text-danger"></span>
                            </fieldset>
                        </div>
                        <div class="col-lg-12">
                            <fieldset>
                                <label asp-for="Input.Subject">موضوع</label>
                                <input asp-for="Input.Subject" placeholder="موضوع..." autocomplete="on">
                                <span asp-validation-for="Input.Subject" class="text-danger"></span>
                            </fieldset>
                        </div>
                        <div class="col-lg-12">
                            <fieldset>
                                <label asp-for="Input.Message">پیام</label>
                                <textarea asp-for="Input.Message" placeholder="پیام شما"></textarea>
                                <span asp-validation-for="Input.Message" class="text-danger"></span>
                            </fieldset>
                        </div>
                        <div class="col-lg-12">
                            <fieldset>
                                <button type="submit" id="form-submit" class="orange-button">ارسال پیام</button>
                            </fieldset>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>