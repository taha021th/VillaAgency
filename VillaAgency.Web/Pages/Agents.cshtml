@page
@model VillaAgency.Web.Pages.AgentsModel
@{
    ViewData["Title"] = "مشاوران ما";
}

<div class="page-heading header-text">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <span class="breadcrumb"><a asp-page="/Index">خانه</a> / مشاوران</span>
                <h3>مشاوران ما</h3>
            </div>
        </div>
    </div>
</div>

<div class="section properties">
    <div class="container">
        <div class="row">
            @foreach (var agent in Model.Agents)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="item">
                        <a asp-page="/AgentDetails" asp-route-id="@agent.Id">
                            <img src="~/images/agents/@(agent.ProfileImageUrl ?? "default-agent.jpg")" alt="عکس پروفایل @agent.FullName">
                        </a>
                        <div class="p-3">
                            <h4><a asp-page="/AgentDetails" asp-route-id="@agent.Id">@agent.FullName</a></h4>
                            <ul class="mt-2">
                                <li><i class="fa fa-envelope"></i> @agent.Email</li>
                                <li><i class="fa fa-phone"></i> @agent.PhoneNumber</li>
                            </ul>
                            <div class="main-button mt-3">
                                <a asp-page="/AgentDetails" asp-route-id="@agent.Id">مشاهده پروفایل و املاک</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>