@page
@model VillaAgency.Web.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "مدیریت کاربران";
}

<div class="page-heading header-text">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <h3>مدیریت کاربران</h3>
                <span class="breadcrumb"><a asp-page="/Admin/Index">پنل مدیریت</a> / کاربران</span>
            </div>
        </div>
    </div>
</div>

<div class="contact-page section">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <p>
                    <a asp-page="Register" class="btn btn-primary">افزودن کاربر/مشاور جدید</a>
                </p>
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>نام کامل</th>
                            <th>ایمیل</th>
                            <th>نقش‌ها</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>@user.FullName</td>
                                <td>@user.Email</td>
                                <td>@string.Join(", ", Model.UserRoles[user.Id])</td>
                                <td>

                                    <!-- این لینک اصلاح می‌شود -->
                                    <a asp-page="./EditRoles" asp-route-id="@user.Id" class="btn btn-sm btn-info">ویرایش نقش‌ها</a>

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>