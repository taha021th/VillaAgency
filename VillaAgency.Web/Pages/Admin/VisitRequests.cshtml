@page
@model VillaAgency.Web.Pages.Admin.VisitRequestsModel
@{
    ViewData["Title"] = "درخواست‌های بازدید";
}

<div class="page-heading header-text">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <h3>درخواست‌های بازدید</h3>
                <span class="breadcrumb"><a asp-page="/Admin/Index">پنل مدیریت</a> / درخواست‌ها</span>
            </div>
        </div>
    </div>
</div>

<div class="contact-page section">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>متقاضی</th>
                            <th>ملک</th>
                            <th>تاریخ درخواست</th>
                            <th>وضعیت</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var req in Model.Requests)

                        {
                            <tr>
                                <td>
                                    @req.UserName <br />
                                    <small>@req.UserPhone</small>
                                </td>
                                <td><a asp-page="/PropertyDetails" asp-route-id="@req.PropertyId">@req.PropertyName</a></td>
                                <td>@req.RequestDate.ToShortDateString()</td>
                                <td>
                                    @if (req.Status == "Pending")

                                    {
                                        <span class="badge bg-warning text-dark">در انتظار</span>
                                    }

                                    else

                                    {
                                        <span class="badge bg-success">تماس گرفته شد</span>
                                    }
                                </td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-info"
                                            data-bs-toggle="modal" data-bs-target="#reportModal"
                                            data-request-id="@req.Id"
                                            data-reports='@System.Text.Json.JsonSerializer.Serialize(req.Reports)'>
                                        مدیریت گزارش‌ها (@req.Reports.Count)
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal for Reporting -->
<div class="modal fade" id="reportModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">مدیریت گزارش‌ها</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- بخش نمایش گزارش‌های قبلی -->
                <h6>گزارش‌های ثبت شده</h6>
                <div id="previous-reports" class="mb-4" style="max-height: 200px; overflow-y: auto;">
                    <p>هیچ گزارشی ثبت نشده است.</p>
                </div>
                <hr />
                <!-- فرم ثبت گزارش جدید -->
                <h6>افزودن گزارش جدید</h6>
                <form method="post" asp-page-handler="AddReport">
                    <input type="hidden" id="modalRequestId" asp-for="ReportCommand.VisitRequestId" />
                    <div class="mb-3">
                        <label asp-for="ReportCommand.Notes" class="form-label">جزئیات تماس</label>
                        <textarea asp-for="ReportCommand.Notes" class="form-control" rows="4" required></textarea>
                    </div>
                    <div class="text-end">
                        <button type="submit" class="btn btn-primary">ثبت گزارش</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var reportModal = document.getElementById('reportModal');
        reportModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var requestId = button.getAttribute('data-request-id');
            var reportsJson = button.getAttribute('data-reports');

            var reports = JSON.parse(reportsJson);

            var modalRequestIdInput = reportModal.querySelector('#modalRequestId');
            var previousReportsDiv = reportModal.querySelector('#previous-reports');

            modalRequestIdInput.value = requestId;
            previousReportsDiv.innerHTML = ''; // Clear previous content

            if (reports && reports.length > 0) {
                reports.forEach(function (report) {
                    var reportDate = new Date(report.ReportDate).toLocaleString('fa-IR');
                    var reportElement = document.createElement('div');
                    reportElement.className = 'border-bottom pb-2 mb-2';
                    reportElement.innerHTML = `<p class="mb-1">${report.Notes}</p><small class="text-muted">ثبت شده در: ${reportDate}</small>`;
                    previousReportsDiv.appendChild(reportElement);
                });
            } else {
                previousReportsDiv.innerHTML = '<p>هیچ گزارشی ثبت نشده است.</p>';
            }
        });
    </script>
}