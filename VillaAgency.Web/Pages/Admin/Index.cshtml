@page
@model VillaAgency.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "داشبورد مدیریت";
}
<style>
    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    }
</style>

<div class="bg-slate-50 p-4 md:p-6 lg:p-8">
    <!-- بخش هدر و فرم بازه زمانی -->
    <div class="md:flex md:items-center md:justify-between mb-8">
        <div>
            <h1 class="text-3xl font-bold text-gray-800">داشبورد مدیریتی</h1>
            <p class="mt-2 text-sm text-gray-500">خلاصه وضعیت و آمارهای کلیدی سامانه.</p>
        </div>
        <!-- فرم جدید برای انتخاب بازه زمانی -->
        <div class="mt-4 md:mt-0">
            <form method="get" class="flex items-center space-x-2 space-x-reverse bg-white p-2 rounded-lg border">
                <label for="period" class="text-sm font-medium text-gray-700 whitespace-nowrap">آمار برای</label>
                <input type="number" name="PeriodInDays" id="period" value="@Model.PeriodInDays" class="block w-24 rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                <label for="period" class="text-sm font-medium text-gray-700">روز گذشته</label>
                <button type="submit" class="inline-flex items-center px-3 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                    اعمال
                </button>
            </form>
        </div>
    </div>

    <!-- بخش کارت‌های آماری -->
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-4">
        <!-- کارت تعداد املاک -->
        <div class="stat-card transition-all duration-300 bg-white overflow-hidden rounded-xl border border-gray-200 shadow-sm">
            <div class="p-5">
                <div class="flex items-start justify-between">
                    <div class="flex-shrink-0">
                        <i class="fa-solid fa-home fa-2x text-blue-500"></i>
                    </div>
                    <div class="text-right">
                        <p class="truncate text-sm font-medium text-gray-500">کل املاک ثبت شده</p>
                        <p class="text-3xl font-bold text-gray-900">@Model.DashboardVm.TotalProperties</p>
                        <p class="text-xs text-green-600 font-semibold mt-1">
                            +@Model.DashboardVm.PropertiesRegisteredInPeriod
                            در @Model.DashboardVm.PeriodInDays روز گذشته
                        </p>
                    </div>
                </div>
            </div>
            <div class="bg-gray-50 px-5 py-3">
                <div class="text-sm">
                    <a href="/Admin/Property" class="font-medium text-blue-600 hover:text-blue-800">مشاهده لیست املاک &rarr;</a>
                </div>
            </div>
        </div>

        <!-- کارت تعداد کاربران -->
        <div class="stat-card transition-all duration-300 bg-white overflow-hidden rounded-xl border border-gray-200 shadow-sm">
            <div class="p-5">
                <div class="flex items-start justify-between">
                    <div class="flex-shrink-0">
                        <i class="fa-solid fa-users fa-2x text-green-500"></i>
                    </div>
                    <div class="text-right">
                        <p class="truncate text-sm font-medium text-gray-500">تعداد کل کاربران</p>
                        <p class="text-3xl font-bold text-gray-900">@Model.DashboardVm.TotalUsers</p>
                        <p class="text-xs text-green-600 font-semibold mt-1">
                            +@Model.DashboardVm.UsersRegisteredInPeriod
                            در @Model.DashboardVm.PeriodInDays روز گذشته
                        </p>
                    </div>
                </div>
            </div>
            <div class="bg-gray-50 px-5 py-3">
                <div class="text-sm">
                    <a href="/Admin/Users/Index" class="font-medium text-green-600 hover:text-green-800">مدیریت کاربران &rarr;</a>
                </div>
            </div>
        </div>
        <!-- کارت درخواست‌های بازدید -->
        <div class="stat-card transition-all duration-300 bg-white overflow-hidden rounded-xl border border-gray-200 shadow-sm">
            <div class="p-5">
                <div class="flex items-start justify-between">
                    <div class="flex-shrink-0">
                        <i class="fa-solid fa-calendar-check fa-2x text-amber-500"></i>
                    </div>
                    <div class="text-right">
                        <p class="truncate text-sm font-medium text-gray-500">کل درخواست‌های بازدید</p>
                        <p class="text-3xl font-bold text-gray-900">@Model.DashboardVm.TotalVisitRequests</p>
                        <p class="text-xs text-green-600 font-semibold mt-1">
                            +@Model.DashboardVm.VisitRequestsInPeriod
                            در @Model.DashboardVm.PeriodInDays روز گذشته
                        </p>
                    </div>
                </div>
            </div>
            <div class="bg-gray-50 px-5 py-3">
                <div class="text-sm">
                    <a href="/Admin/VisitRequests" class="font-medium text-amber-600 hover:text-amber-800">بررسی درخواست‌ها &rarr;</a>
                </div>
            </div>
        </div>
        <!-- کارت پیام‌های جدید -->
        <div class="stat-card transition-all duration-300 bg-white overflow-hidden rounded-xl border border-gray-200 shadow-sm">
            <div class="p-5">
                <div class="flex items-start justify-between">
                    <div class="flex-shrink-0">
                        <i class="fa-solid fa-inbox fa-2x text-red-500"></i>
                    </div>
                    <div class="text-right">
                        <p class="truncate text-sm font-medium text-gray-500">پیام‌های خوانده نشده</p>
                        <p class="text-3xl font-bold text-gray-900">@Model.DashboardVm.UnreadMessages</p>
                    </div>
                </div>
            </div>
            <div class="bg-gray-50 px-5 py-3">
                <div class="text-sm">
                    <a href="/Admin/Messages" class="font-medium text-red-600 hover:text-red-800">مشاهده پیام‌ها &rarr;</a>
                </div>
            </div>
        </div>
    </div>

    <!-- بخش نمودار و جدول -->
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2 mt-8">
        <!-- جدول آخرین درخواست‌های بازدید -->
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">آخرین درخواست‌های بازدید</h3>
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-right">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="p-3 font-semibold text-gray-600">نام ملک</th>
                            <th class="p-3 font-semibold text-gray-600">متقاضی</th>
                            <th class="p-3 font-semibold text-gray-600">وضعیت</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.DashboardVm.RecentVisitRequests)
                        {
                            <tr class="border-b border-gray-100 last:border-b-0">
                                <td class="p-3 text-gray-800">@item.PropertyName</td>
                                <td class="p-3 text-gray-500">@item.UserName</td>
                                <td class="p-3">
                                    @if (item.Status == "Pending")
                                    {
                                        <span class="inline-flex items-center bg-amber-100 text-amber-800 text-xs font-medium px-2.5 py-0.5 rounded-full">
                                            <span class="w-2 h-2 mr-1 bg-amber-500 rounded-full"></span>
                                            در انتظار
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded-full">
                                            <span class="w-2 h-2 mr-1 bg-blue-500 rounded-full"></span>
                                            @item.Status
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- نمودار وضعیت درخواست‌ها -->
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">تفکیک وضعیت درخواست‌ها</h3>
            <div class="mx-auto" style="position: relative; height:300px; width:100%; max-width:300px">
                <canvas id="requestsChart"></canvas>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const pendingRequests = @Model.DashboardVm.PendingVisitRequests;
            const totalRequests = @Model.DashboardVm.TotalVisitRequests;
            const otherRequests = totalRequests - pendingRequests;

            const requestsCtx = document.getElementById('requestsChart').getContext('2d');
            new Chart(requestsCtx, {
                type: 'doughnut',
                data: {
                    labels: ['در انتظار', 'سایر'],
                    datasets: [{
                        data: [pendingRequests, otherRequests],
                        backgroundColor: ['#f59e0b', '#3b82f6'],
                        hoverBackgroundColor: ['#d97706', '#2563eb'],
                        borderColor: '#fff',
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '70%',
                    plugins: {
                        legend: {
                            display: true,
                            position: 'bottom',
                            labels: {
                                font: { family: "'Vazirmatn', sans-serif" },
                                padding: 20
                            }
                        },
                        tooltip: {
                            rtl: true,
                            bodyFont: { family: "'Vazirmatn', sans-serif" },
                            titleFont: { family: "'Vazirmatn', sans-serif" }
                        }
                    }
                }
            });
        });
    </script>
}
