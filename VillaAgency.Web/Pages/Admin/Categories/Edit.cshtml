@page "{id:guid}"
@model VillaAgency.Web.Pages.Admin.Categories.EditModel
@{
    ViewData["Title"] = "ویرایش دسته‌بندی";
}

<div class="page-heading header-text">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <h3>ویرایش دسته‌بندی: @Model.Command.Name</h3>
            </div>
        </div>
    </div>
</div>

<div class="contact-page section">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 offset-lg-3">
                <form method="post">
                    <input type="hidden" asp-for="Command.Id" />
                    <div class="form-group mb-3">
                        <label asp-for="Command.Name" class="control-label">نام دسته‌بندی</label>
                        <input asp-for="Command.Name" class="form-control" />
                        <span asp-validation-for="Command.Name" class="text-danger"></span>
                    </div>
                    <div class="form-group mt-4">
                        <button type="submit" class="btn btn-success">ذخیره</button>
                        <a asp-page="Index" class="btn btn-secondary">انصراف</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
