@page
@model VillaAgency.Web.Pages.Admin.Properties.CreateModel
@{
    ViewData["Title"] = "افزودن ملک جدید";
}

<style>
    /* Stepper Styles (مشابه قبل) */
    .stepper-wrapper {
        display: flex;
        justify-content: space-between;
        margin-bottom: 2.5rem;
    }

    .stepper-item {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        flex: 1;
        text-align: center;
    }

        .stepper-item::before {
            position: absolute;
            content: "";
            border-bottom: 2px solid #e0e0e0;
            width: 100%;
            top: 20px;
            left: -50%;
            z-index: 2;
        }

        .stepper-item::after {
            position: absolute;
            content: "";
            border-bottom: 2px solid #e0e0e0;
            width: 100%;
            top: 20px;
            left: 50%;
            z-index: 2;
        }

        .stepper-item .step-counter {
            position: relative;
            z-index: 5;
            display: flex;
            justify-content: center;
            align-items: center;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #e0e0e0;
            margin-bottom: 0.5rem;
            transition: background-color 0.3s, border-color 0.3s;
            border: 2px solid transparent;
            color: #fff;
        }

        .stepper-item .step-name {
            font-size: 0.85rem;
            color: #6c757d;
        }

        .stepper-item.active .step-counter {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }

        .stepper-item.active .step-name {
            color: #0d6efd;
            font-weight: 600;
        }

        .stepper-item.completed .step-counter {
            background-color: #198754;
            border-color: #198754;
        }

        .stepper-item.completed::after {
            border-bottom-color: #198754;
        }

        .stepper-item:first-child::before {
            content: none;
        }

        .stepper-item:last-child::after {
            content: none;
        }

    .step-content {
        display: none;
    }

        .step-content.active {
            display: block;
            animation: fadeIn 0.5s;
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Awesome File Uploader Styles */
    #drop-area {
        border: 2px dashed #ccc;
        border-radius: 12px;
        padding: 40px;
        text-align: center;
        cursor: pointer;
        transition: border-color 0.3s, background-color 0.3s;
    }

        #drop-area.highlight {
            border-color: #0d6efd;
            background-color: #f8f9fa;
        }

        #drop-area .upload-text {
            color: #6c757d;
        }

    #preview-area {
        margin-top: 1.5rem;
    }

    .preview-item {
        position: relative;
        width: 120px;
        height: 120px;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid #dee2e6;
    }

        .preview-item img, .preview-item .video-placeholder {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .preview-item .video-placeholder {
            background-color: #343a40;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
        }

        .preview-item .remove-file-btn {
            position: absolute;
            top: 4px;
            right: 4px;
            width: 24px;
            height: 24px;
            background-color: rgba(220, 53, 69, 0.8);
            color: white;
            border: none;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            line-height: 1;
            font-size: 14px;
            font-weight: bold;
            opacity: 0;
            transition: opacity 0.3s;
        }

        .preview-item:hover .remove-file-btn {
            opacity: 1;
        }

    .file-name {
        font-size: 0.75rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        padding: 4px;
        background-color: rgba(0,0,0,0.5);
        color: white;
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
    }
</style>

<div class="container py-5">
    <div class="col-lg-10 col-xl-9 mx-auto">
        <div class="text-center mb-5">
            <h1 class="h2 fw-bold">افزودن ملک جدید</h1>
            <p class="text-muted">با تکمیل مراحل زیر، ملک خود را به سادگی در سامانه ثبت کنید.</p>
        </div>

        <form method="post" id="createPropertyForm" enctype="multipart/form-data" novalidate>
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-lg-5">

                    <div class="stepper-wrapper">
                        <div class="stepper-item active" data-step="1"><div class="step-counter"><i class="bi bi-person-badge"></i></div><div class="step-name">معامله و تماس</div></div>
                        <div class="stepper-item" data-step="2"><div class="step-counter"><i class="bi bi-building"></i></div><div class="step-name">اطلاعات اصلی</div></div>
                        <div class="stepper-item" data-step="3"><div class="step-counter"><i class="bi bi-rulers"></i></div><div class="step-name">جزئیات فنی</div></div>
                        <div class="stepper-item" data-step="4"><div class="step-counter"><i class="bi bi-cloud-arrow-up"></i></div><div class="step-name">بارگذاری رسانه</div></div>
                    </div>

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="step-content active" data-step="1">
                        <h5 class="mb-4 fw-bold">مرحله ۱: نوع معامله و اطلاعات تماس</h5>
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">نوع معامله</label>
                                <div class="d-flex gap-3">
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" asp-for="PropertyCommand.TransactionType" value="خرید و فروش" id="buyRadio" checked>
                                        <label for="buyRadio" class="form-check-label">خرید و فروش</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" asp-for="PropertyCommand.TransactionType" value="رهن و اجاره" id="rentRadio">
                                        <label for="rentRadio" class="form-check-label">رهن و اجاره</label>
                                    </div>
                                </div>
                                <span asp-validation-for="PropertyCommand.TransactionType" class="text-danger small d-block mt-1"></span>
                            </div>
                            <div class="col-md-6"><label asp-for="PropertyCommand.FullName" class="form-label">نام کامل مالک/نماینده</label><input asp-for="PropertyCommand.FullName" class="form-control"><span asp-validation-for="PropertyCommand.FullName" class="text-danger small"></span></div>
                            <div class="col-md-6"><label asp-for="PropertyCommand.PhoneNumber" class="form-label">شماره تماس</label><input asp-for="PropertyCommand.PhoneNumber" class="form-control"><span asp-validation-for="PropertyCommand.PhoneNumber" class="text-danger small"></span></div>
                        </div>
                    </div>

                    <div class="step-content" data-step="2">
                        <h5 class="mb-4 fw-bold">مرحله ۲: اطلاعات اصلی ملک</h5>
                        <div class="row g-3">
                            <div class="col-md-6"><label asp-for="PropertyCommand.CategoryId" class="form-label">دسته‌بندی ملک</label><select asp-for="PropertyCommand.CategoryId" class="form-select" asp-items="Model.CategoryList"><option value="">-- انتخاب کنید --</option></select><span asp-validation-for="PropertyCommand.CategoryId" class="text-danger small"></span></div>
                            <div class="col-md-6"><label asp-for="PropertyCommand.Title" class="form-label">عنوان آگهی</label><input asp-for="PropertyCommand.Title" class="form-control" placeholder="مثلا: آپارتمان شیک در مرکز شهر"><span asp-validation-for="PropertyCommand.Title" class="text-danger small"></span></div>
                            <div class="col-12"><label asp-for="PropertyCommand.Address" class="form-label">آدرس دقیق ملک</label><input asp-for="PropertyCommand.Address" class="form-control"><span asp-validation-for="PropertyCommand.Address" class="text-danger small"></span></div>
                            <div class="col-12"><label asp-for="PropertyCommand.Description" class="form-label">توضیحات تکمیلی</label><textarea asp-for="PropertyCommand.Description" rows="4" class="form-control"></textarea><span asp-validation-for="PropertyCommand.Description" class="text-danger small"></span></div>
                        </div>
                    </div>

                    <div class="step-content" data-step="3">
                        <h5 class="mb-4 fw-bold">مرحله ۳: جزئیات فنی</h5>
                        <div class="row g-3">
                            <div class="col-md-6"><label asp-for="PropertyCommand.Price" class="form-label">قیمت (تومان)</label><input asp-for="PropertyCommand.Price" type="number" class="form-control"><span asp-validation-for="PropertyCommand.Price" class="text-danger small"></span></div>
                            <div class="col-md-6"><label asp-for="PropertyCommand.Area" class="form-label">متراژ (متر مربع)</label><input asp-for="PropertyCommand.Area" type="number" class="form-control"><span asp-validation-for="PropertyCommand.Area" class="text-danger small"></span></div>
                            <div class="col-md-4"><label asp-for="PropertyCommand.Bedrooms" class="form-label">تعداد خواب</label><input asp-for="PropertyCommand.Bedrooms" type="number" class="form-control"><span asp-validation-for="PropertyCommand.Bedrooms" class="text-danger small"></span></div>
                            <div class="col-md-4"><label asp-for="PropertyCommand.Floor" class="form-label">طبقه</label><input asp-for="PropertyCommand.Floor" type="number" class="form-control"><span asp-validation-for="PropertyCommand.Floor" class="text-danger small"></span></div>
                            <div class="col-md-4"><label asp-for="PropertyCommand.FloorsCount" class="form-label">تعداد کل طبقات</label><input asp-for="PropertyCommand.FloorsCount" type="number" class="form-control"><span asp-validation-for="PropertyCommand.FloorsCount" class="text-danger small"></span></div>
                            <div class="col-md-6"><label asp-for="PropertyCommand.Unit" class="form-label">شماره واحد</label><input asp-for="PropertyCommand.Unit" type="number" class="form-control"><span asp-validation-for="PropertyCommand.Unit" class="text-danger small"></span></div>
                            <div class="col-md-6"><label asp-for="PropertyCommand.UnitsCountInFloor" class="form-label">واحد در طبقه</label><input asp-for="PropertyCommand.UnitsCountInFloor" type="number" class="form-control"><span asp-validation-for="PropertyCommand.UnitsCountInFloor" class="text-danger small"></span></div>
                            <div class="col-md-6"><label asp-for="PropertyCommand.BuildDate" class="form-label">تاریخ ساخت</label><input asp-for="PropertyCommand.BuildDate" id="buildDatePicker" class="form-control bg-white" autocomplete="off"><span asp-validation-for="PropertyCommand.BuildDate" class="text-danger small"></span></div>
                        </div>
                    </div>

                    <div class="step-content" data-step="4">
                        <h5 class="mb-4 fw-bold">مرحله ۴: بارگذاری تصاویر و ویدئوها</h5>
                        <div class="d-none">
                            <input asp-for="ImageFiles" type="file" multiple>
                            <input asp-for="VideoFiles" type="file" multiple>
                        </div>

                        <div id="drop-area">
                            <i class="bi bi-cloud-upload fs-1 text-primary"></i>
                            <p class="upload-text mt-3 mb-0">
                                تصاویر و ویدئوها را اینجا بکشید و رها کنید<br>
                                یا <span class="text-primary fw-bold">برای انتخاب فایل کلیک کنید</span>
                            </p>
                        </div>
                        <div id="preview-area" class="d-flex flex-wrap gap-3">
                        </div>
                        <span asp-validation-for="ImageFiles" class="text-danger small"></span>
                        <span asp-validation-for="VideoFiles" class="text-danger small"></span>
                    </div>

                </div>
                <div class="card-footer bg-light border-0 py-3 px-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <button type="button" class="btn btn-outline-secondary" id="prevBtn" style="display:none;">
                            <i class="bi bi-arrow-right"></i> مرحله قبل
                        </button>
                        <button type="button" class="btn btn-primary" id="nextBtn">
                            مرحله بعد <i class="bi bi-arrow-left"></i>
                        </button>
                        <button type="submit" class="btn btn-success" id="submitBtn" style="display:none;">
                            <i class="bi bi-check-circle-fill"></i> ایجاد ملک
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <link href="https://cdn.jsdelivr.net/npm/kamadatepicker@1.5.1/dist/kamadatepicker.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/kamadatepicker@1.5.1/dist/kamadatepicker.min.js"></script>

    <script type="text/javascript">
        document.addEventListener("DOMContentLoaded", function () {

            // --- Wizard Navigation Logic ---
            const steps = document.querySelectorAll(".step-content");
            const stepperItems = document.querySelectorAll(".stepper-item");
            const prevBtn = document.getElementById("prevBtn");
            const nextBtn = document.getElementById("nextBtn");
            const submitBtn = document.getElementById("submitBtn");
            let currentStep = 1;

            function showStep(stepNumber) {
                steps.forEach(step => step.classList.remove('active'));
                document.querySelector(`.step-content[data-step="${stepNumber}"]`).classList.add('active');
                prevBtn.style.display = (stepNumber === 1) ? 'none' : 'inline-block';
                nextBtn.style.display = (stepNumber === steps.length) ? 'none' : 'inline-block';
                submitBtn.style.display = (stepNumber === steps.length) ? 'inline-block' : 'none';
                updateStepper(stepNumber);
            }

            function updateStepper(stepNumber) {
                stepperItems.forEach((item, index) => {
                    item.classList.remove('active', 'completed');
                    if (index < stepNumber - 1) item.classList.add('completed');
                    else if (index === stepNumber - 1) item.classList.add('active');
                });
            }

            nextBtn.addEventListener('click', () => {
                if (currentStep < steps.length) { currentStep++; showStep(currentStep); }
            });

            prevBtn.addEventListener('click', () => {
                if (currentStep > 1) { currentStep--; showStep(currentStep); }
            });

            // --- kamadatepicker Logic ---
            kamaDatepicker('buildDatePicker', {
                forceDigits: 'en', buttonsColor: "blue", markToday: true,
                gotoToday: true, autoClose: true, placeholder: "سال/ماه/روز", format: "YYYY/MM/DD"
            });

            // --- Awesome File Uploader Logic ---
            const dropArea = document.getElementById('drop-area');
            const hiddenImageInput = document.getElementById('@Html.IdFor(m => m.ImageFiles)');
            const hiddenVideoInput = document.getElementById('@Html.IdFor(m => m.VideoFiles)');
            const previewArea = document.getElementById('preview-area');
            let allFiles = []; // To store File objects

            dropArea.addEventListener('click', () => {
                const combinedInput = document.createElement('input');
                combinedInput.type = 'file';
                combinedInput.multiple = true;
                combinedInput.accept = "image/*,video/*";
                combinedInput.onchange = e => { handleFiles(e.target.files); };
                combinedInput.click();
            });

            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eName => dropArea.addEventListener(eName, e => { e.preventDefault(); e.stopPropagation(); }, false));
            ['dragenter', 'dragover'].forEach(eName => dropArea.addEventListener(eName, () => dropArea.classList.add('highlight'), false));
            ['dragleave', 'drop'].forEach(eName => dropArea.addEventListener(eName, () => dropArea.classList.remove('highlight'), false));
            dropArea.addEventListener('drop', (e) => handleFiles(e.dataTransfer.files), false);

            function handleFiles(files) {
                for (const file of files) {
                    if (!allFiles.some(f => f.name === file.name && f.size === file.size)) {
                        allFiles.push(file);
                        createPreview(file);
                    }
                }
            }

            function createPreview(file) {
                const fileIndex = allFiles.length - 1;
                const previewItem = document.createElement('div');
                previewItem.className = 'preview-item';

                if (file.type.startsWith('image/')) {
                    const reader = new FileReader();
                    reader.onload = e => { previewItem.innerHTML = `<img src="${e.target.result}" />` + previewItem.innerHTML; };
                    reader.readAsDataURL(file);
                } else if (file.type.startsWith('video/')) {
                    previewItem.innerHTML = '<div class="video-placeholder"><i class="bi bi-film"></i></div>' + previewItem.innerHTML;
                }

                previewItem.innerHTML += `<div class="file-name">${file.name}</div>
                                                  <button type="button" class="remove-file-btn">&times;</button>`;

                previewItem.querySelector('.remove-file-btn').onclick = () => {
                    allFiles = allFiles.filter((f, i) => i !== fileIndex);
                    previewArea.removeChild(previewItem);
                };
                previewArea.appendChild(previewItem);
            }

            // --- Form Submission Logic ---
            const form = document.getElementById('createPropertyForm');
            form.addEventListener('submit', function (e) {
                // This is the critical part to make it work with the existing backend model
                e.preventDefault();

                const imageDt = new DataTransfer();
                const videoDt = new DataTransfer();

                // Separate files into images and videos
                allFiles.forEach(file => {
                    if (file.type.startsWith('image/')) {
                        imageDt.items.add(file);
                    } else if (file.type.startsWith('video/')) {
                        videoDt.items.add(file);
                    }
                });

                // Assign the separated file lists to the original hidden inputs
                hiddenImageInput.files = imageDt.files;
                hiddenVideoInput.files = videoDt.files;

                // Now submit the form, which has the correct files in the correct inputs
                form.submit();
            });
        });
    </script>
}