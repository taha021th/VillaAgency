@page
@model VillaAgency.Web.Pages.Admin.Properties.IndexModel
@{
    ViewData["Title"] = "مدیریت املاک";
}

<div class="container-fluid py-4">

    <div class="card shadow-sm border-0 rounded-4">
        <!-- Card Header -->
        <div class="card-header bg-light p-3 border-bottom-0">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0 fw-bold">
                    <i class="bi bi-building me-2"></i>
                    مدیریت املاک
                </h4>
                <a asp-page="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle-fill me-1"></i>
                    افزودن ملک جدید
                </a>
            </div>
        </div>

        <!-- Card Body & Table -->
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-4" style="width: 30%;">ملک</th>
                            <th scope="col">قیمت (تومان)</th>
                            <th scope="col">مشاور</th>
                            <th scope="col" style="width: 35%;">وضعیت و ویژگی‌ها</th>
                            <th scope="col" class="text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var property in Model.Properties)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold">@property.Title</div>
                                    <div class="small text-muted">
                                        <span>@property.CategoryName</span> |
                                        <span>@property.FullName (@property.PhoneNumber)</span>
                                    </div>
                                </td>
                                <td>@property.Price.ToString("N0")</td>
                                <td>@(property.AgentName ?? "---")</td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        <!-- IsInSlider Toggle -->
                                        <form method="post" asp-page-handler="ToggleSliderStatus" asp-route-id="@property.Id" asp-route-pageNum="@Model.PageNum">
                                            @if (property.IsInSlider)
                                            {
                                                <button type="submit" class="btn btn-success btn-sm" title="فعال در اسلایدر - کلیک برای غیرفعال کردن"><i class="bi bi-check-circle-fill"></i> اسلایدر</button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-outline-secondary btn-sm" title="غیرفعال در اسلایدر - کلیک برای فعال کردن" disabled="@(Model.SliderPropertiesCount >= 6)"><i class="bi bi-circle"></i> اسلایدر</button>
                                            }
                                        </form>
                                        <!-- IsFeatured Toggle -->
                                        <form method="post" asp-page-handler="ToggleIsFeaturePropertyStatus" asp-route-id="@property.Id" asp-route-pageNum="@Model.PageNum">
                                            @if (property.IsFeatured)
                                            {
                                                <button type="submit" class="btn btn-success btn-sm" title="ملک ویژه - کلیک برای عادی کردن"><i class="bi bi-check-circle-fill"></i> ویژه</button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-outline-secondary btn-sm" title="ملک عادی - کلیک برای ویژه کردن" disabled="@(Model.IsFeaturePropertiesCount >= 6)"><i class="bi bi-circle"></i> ویژه</button>
                                            }
                                        </form>
                                        <!-- IsInApartment Toggle -->
                                        <form method="post" asp-page-handler="TogglePropertyIsInApartmentStatus" asp-route-id="@property.Id" asp-route-pageNum="@Model.PageNum">
                                            @if (property.IsInApartment)
                                            {
                                                <button type="submit" class="btn btn-info btn-sm" title="نمایش در آپارتمان‌ها - کلیک برای حذف"><i class="bi bi-check-circle-fill"></i> آپارتمان</button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-outline-secondary btn-sm" title="عدم نمایش در آپارتمان‌ها - کلیک برای افزودن" disabled="@(Model.IsInApartmentPropertiesCount >= 6)"><i class="bi bi-circle"></i> آپارتمان</button>
                                            }
                                        </form>
                                        <!-- IsInVilla Toggle -->
                                        <form method="post" asp-page-handler="TogglePropertyIsInVillaStatus" asp-route-id="@property.Id" asp-route-pageNum="@Model.PageNum">
                                            @if (property.IsInVilla)
                                            {
                                                <button type="submit" class="btn btn-info btn-sm" title="نمایش در ویلاها - کلیک برای حذف"><i class="bi bi-check-circle-fill"></i> ویلا</button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-outline-secondary btn-sm" title="عدم نمایش در ویلاها - کلیک برای افزودن" disabled="@(Model.IsInVillaPropertiesCount >= 6)"><i class="bi bi-circle"></i> ویلا</button>
                                            }
                                        </form>
                                        <!-- IsInPentHouse Toggle -->
                                        <form method="post" asp-page-handler="TogglePropertyIsInPentHouseStatus" asp-route-id="@property.Id" asp-route-pageNum="@Model.PageNum">
                                            @if (property.IsInPentHouse)
                                            {
                                                <button type="submit" class="btn btn-info btn-sm" title="نمایش در پنت‌هاوس‌ها - کلیک برای حذف"><i class="bi bi-check-circle-fill"></i> پنت‌هاوس</button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-outline-secondary btn-sm" title="عدم نمایش در پنت‌هاوس‌ها - کلیک برای افزودن" disabled="@(Model.IsInPentHousePropertiesCount >= 6)"><i class="bi bi-circle"></i> پنت‌هاوس</button>
                                            }
                                        </form>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-sm btn-outline-dark dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-gear-fill"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li><a class="dropdown-item" asp-page="Edit" asp-route-id="@property.Id"><i class="bi bi-pencil-square me-2"></i>ویرایش</a></li>
                                            <li><a class="dropdown-item text-danger" asp-page="Delete" asp-route-id="@property.Id"><i class="bi bi-trash-fill me-2"></i>حذف</a></li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-light border-0">
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item @(Model.PageNum > 1 ? "" : "disabled")">
                            <a class="page-link" asp-page="/Admin/Properties/Index" asp-route-pageNum="@(Model.PageNum - 1)">قبلی</a>
                        </li>

                        @{
                            int startPage = Math.Max(1, Model.PageNum - 2);
                            int endPage = Math.Min(Model.TotalPages, Model.PageNum + 2);

                            if (startPage > 1)
                            {
                                <li class="page-item"><a class="page-link" asp-page="/Admin/Properties/Index" asp-route-pageNum="1">1</a></li>
                                if (startPage > 2)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                            }

                            for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == Model.PageNum ? "active" : "")">
                                    <a class="page-link" asp-page="/Admin/Properties/Index" asp-route-pageNum="@i">@i</a>
                                </li>
                            }

                            if (endPage < Model.TotalPages)
                            {
                                if (endPage < Model.TotalPages - 1)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                                <li class="page-item"><a class="page-link" asp-page="/Admin/Properties/Index" asp-route-pageNum="@Model.TotalPages">@Model.TotalPages</a></li>
                            }
                        }

                        <li class="page-item @(Model.PageNum < Model.TotalPages ? "" : "disabled")">
                            <a class="page-link" asp-page="/Admin/Properties/Index" asp-route-pageNum="@(Model.PageNum + 1)">بعدی</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>