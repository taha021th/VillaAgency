@page
@model VillaAgency.Web.Pages.Admin.Properties.IndexModel
@{
    ViewData["Title"] = "مدیریت املاک";
}

<div class="container mt-5 mb-5">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="mb-0">لیست املاک</h2>
                <a asp-page="Create" class="btn btn-primary">افزودن ملک جدید</a>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>عنوان</th>
                            <th>دسته‌بندی</th>
                            <th>قیمت (تومان)</th>
                            <th>مشاور</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var property in Model.Properties)
                        {
                            <tr>
                                <td>@property.Title</td>
                                <td>@property.CategoryName</td>
                                <td>@property.Price.ToString("N0")</td>
                                <td>@property.AgentName</td>
                                <td>
                                    <a asp-page="Edit" asp-route-id="@property.Id" class="btn btn-sm btn-warning">ویرایش</a>
                                    <a asp-page="Delete" asp-route-id="@property.Id" class="btn btn-sm btn-danger">حذف</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- **بخش صفحه‌بندی اصلاح شده** -->
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center mt-4">
                        <li class="page-item @(Model.PageNum > 1 ? "" : "disabled")">
                            <a class="page-link"
                               asp-page="/Admin/Properties/Index"
                               asp-route-pageNum="@(Model.PageNum - 1)">قبلی</a>
                        </li>

                        @{
                            int startPage = Math.Max(1, Model.PageNum - 2);
                            int endPage = Math.Min(Model.TotalPages, Model.PageNum + 2);

                            if (startPage > 1)
                            {
                                <li class="page-item"><a class="page-link" asp-page="/Admin/Properties/Index" asp-route-pageNum="1">1</a></li>
                                if (startPage > 2)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                            }

                            for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == Model.PageNum ? "active" : "")">
                                    <a class="page-link"
                                       asp-page="/Admin/Properties/Index"
                                       asp-route-pageNum="@i">@i</a>
                                </li>
                            }

                            if (endPage < Model.TotalPages)
                            {
                                if (endPage < Model.TotalPages - 1)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                                <li class="page-item"><a class="page-link" asp-page="/Admin/Properties/Index" asp-route-pageNum="@Model.TotalPages">@Model.TotalPages</a></li>
                            }
                        }

                        <li class="page-item @(Model.PageNum < Model.TotalPages ? "" : "disabled")">
                            <a class="page-link"
                               asp-page="/Admin/Properties/Index"
                               asp-route-pageNum="@(Model.PageNum + 1)">بعدی</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>
