@page
@model VillaAgency.Web.Pages.ContactModel
@{
    ViewData["Title"] = "تماس با ما";
}

<!-- محتوای منحصر به فرد صفحه تماس با ما از اینجا شروع می‌شود -->

<div class="page-heading header-text">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <span class="breadcrumb"><a asp-page="/Index">خانه</a> / تماس با ما</span>
                <h3>تماس با ما</h3>
            </div>
        </div>
    </div>
</div>

<div class="contact-page section">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <div class="section-heading">
                    <h6>| تماس با ما</h6>
                    <h2>با مشاوران ما در تماس باشید</h2>
                </div>
                <p>این یک متن آزمایشی برای نمایش در این بخش است. شما می‌توانید این متن را با محتوای دلخواه خود جایگزین کنید و اطلاعات بیشتری در مورد خدمات خود ارائه دهید. برای اطلاعات بیشتر با ما تماس بگیرید.</p>
                <div class="row">
                    <div class="col-lg-12">
                        <div class="item phone">
                            <img src="~/images/phone-icon.png" alt="آیکون تلفن" style="max-width: 52px;">
                            <h6>۰۱۲-۳۴۵-۶۷۸۹<br><span>شماره تماس</span></h6>
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <div class="item email">
                            <img src="~/images/email-icon.png" alt="آیکون ایمیل" style="max-width: 52px;">
                            <h6>info@villa.co<br><span>ایمیل کاری</span></h6>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <!-- استفاده از تگ فرم با متد post که به صورت خودکار به همین صفحه ارسال می‌شود -->
                <form id="contact-form" method="post">
                    <!-- نمایش خطاهای کلی مدل -->
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <!-- نمایش پیام موفقیت‌آمیز بودن از TempData -->
                    @if (!string.IsNullOrEmpty(Model.StatusMessage))
                    {
                        <div class="alert alert-success">
                            @Model.StatusMessage
                        </div>
                    }

                    <div class="row">
                        <div class="col-lg-12">
                            <fieldset>
                                <label asp-for="Input.Name">نام کامل</label>
                                <input asp-for="Input.Name" placeholder="نام شما..." autocomplete="on">
                                <span asp-validation-for="Input.Name" class="text-danger"></span>
                            </fieldset>
                        </div>
                        <div class="col-lg-12">
                            <fieldset>
                                <label asp-for="Input.Email">آدرس ایمیل</label>
                                <input asp-for="Input.Email" placeholder="ایمیل شما...">
                                <span asp-validation-for="Input.Email" class="text-danger"></span>
                            </fieldset>
                        </div>
                        <div class="col-lg-12">
                            <fieldset>
                                <label asp-for="Input.Subject">موضوع</label>
                                <input asp-for="Input.Subject" placeholder="موضوع..." autocomplete="on">
                                <span asp-validation-for="Input.Subject" class="text-danger"></span>
                            </fieldset>
                        </div>
                        <div class="col-lg-12">
                            <fieldset>
                                <label asp-for="Input.Message">پیام</label>
                                <textarea asp-for="Input.Message" placeholder="پیام شما"></textarea>
                                <span asp-validation-for="Input.Message" class="text-danger"></span>
                            </fieldset>
                        </div>
                        <div class="col-lg-12">
                            <fieldset>
                                <button type="submit" id="form-submit" class="orange-button">ارسال پیام</button>
                            </fieldset>
                        </div>
                    </div>
                </form>
            </div>
            <div class="col-lg-12">
                <div id="map">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d12469.776493332698!2d-80.14036379941481!3d25.907788681148624!2m3!1f357.26927939317244!2f20.870722720054623!3f0!3m2!1i1024!2i768!4f35!3m3!1m2!1s0x88d9add4b4ac788f%3A0xe77469d09480fcdb!2sSunny%20Isles%20Beach!5e1!3m2!1sen!2sth!4v1642869952544!5m2!1sen!2sth" width="100%" height="500px" frameborder="0" style="border:0; border-radius: 10px; box-shadow: 0px 0px 15px rgba(0, 0, 0, 0.15);" allowfullscreen=""></iframe>
                </div>
            </div>
        </div>
    </div>
</div>
